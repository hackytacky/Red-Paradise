# G9 host environment — TEMPLATE ONLY.
# Copy to ~/.g9/env.sh, chmod 600, fill in the values, and NEVER commit
# the filled file. The control plane passes env-var NAMES only to
# containers (docker -e NAME inherits the host value), so secrets
# never appear in a command line, the audit ledger, or any log.
#
# Rotate any key that has ever been shared in plaintext.

export SHODAN_API_KEY=""
export CENSYS_API_ID=""
export CENSYS_API_SECRET=""
export OTX_API_KEY=""
export INTELX_API_KEY=""
# GHunt: operator Google auth exported per the GHunt docs (data dir path)
export GHUNT_COOKIES=""

# --- agent brains (OpenAI-compatible endpoints, loopback only) ---
# MAIN brain: DeepHat / WhiteRabbitNeo (dedicated cybersecurity model)
export G9_LLM_ENDPOINT="http://127.0.0.1:8000/v1"
export G9_LLM_MODEL="DeepHat-V1-7B"
# FALLBACK brain: auto-failover when the main endpoint is down or
# malformed (recorded in the mission event stream, never silent).
# Qwen3.6-abliterated starts at 27B (does not fit 16GB at usable
# quality) - the fitting fallback is Qwen3-14B-abliterated Q4_K_M.
export G9_LLM_FALLBACK_ENDPOINT="http://127.0.0.1:8001/v1"
export G9_LLM_FALLBACK_MODEL="DeepSeek-V4-Pro-Qwen3.5-9B-heretic"

# SPECIALIST brain: documented cyber/red-team fine-tune (scan-output
# analysis, vulnerability reasoning, triage) - Qwensploit 4B, 2.7GB Q4
export G9_LLM_SPECIALIST_ENDPOINT="http://127.0.0.1:8081/v1"
export G9_LLM_SPECIALIST_MODEL="Qwensploit-4B"

# FAST brain: 2B bulk-triage (near-instant candidate sorting)
export G9_LLM_FAST_ENDPOINT="http://127.0.0.1:8082/v1"
export G9_LLM_FAST_MODEL="DeepSeek-V4.1-Flash-1017"
